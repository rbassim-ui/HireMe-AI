{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build HireMe C backend",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-o",
        "..\\output\\hireme.exe",
        "main.c",
        "db.c",
        "api.c",
        "menu.c",
        "interview.c",
        "json.c",
        "report.c",
        "utils.c",
        "sqlite3.c",
        "-lws2_32",
        "-D_WIN32_WINNT=0x0600",
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Wno-unused-parameter"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend-c"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    }
  ]
}